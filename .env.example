# ------------------------------------------------------------------
# Copier ce fichier en .env puis adapter les valeurs :
#   cp .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore).
# ------------------------------------------------------------------

# Projet Compose (préfixe des conteneurs, réseaux et volumes)
COMPOSE_PROJECT_NAME=projet-docker

# Docker Hub : nom d'utilisateur et tag des images publiées
DOCKERHUB_USER=votre-user-dockerhub
TAG=latest

# Port exposé sur la machine hôte pour l'application
WEB_PORT=8080

# Base de données
DB_NAME=test
DB_USER=test
DB_PASSWORD=changez-moi-app
DB_ROOT_PASSWORD=changez-moi-root
